# Copie para .env e preencha. Nunca versione o .env com senhas reais.

PORT=4000
NODE_ENV=development

# URLs do frontend autorizadas a chamar a API (separadas por vírgula)
ORIGENS_PERMITIDAS=http://localhost:3000,https://www.starcad.com.br

# ---------------------------------------------------------------------------
# SMTP (Nodemailer). Sem essas variáveis a API funciona e grava os contatos
# em dados/contatos.jsonl, mas não envia e-mail.
#
# Gmail: use uma "senha de app" (Conta Google > Segurança > Senhas de app),
# host smtp.gmail.com, porta 587.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Remetente e destinatário das notificações
EMAIL_REMETENTE="Site Starcad" <seu-email@gmail.com>
EMAIL_DESTINO=contato@starcad.com.br

# Caminho do arquivo de registro dos contatos (relativo à pasta do projeto)
ARQUIVO_CONTATOS=dados/contatos.jsonl
